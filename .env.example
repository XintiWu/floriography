#Rename this file to .env

# Gemini API Key (Required for flower recognition service)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RECOMMEND_MODEL=gemini-2.5-flash

# Local AI Configuration (Ollama)
RECOMMEND_LLM_PROVIDER=auto
OLLAMA_MODEL=gemma4:e4b #Choose your model here! Make sure that you already installed Ollama and pulled the model.

# Remote Supabase Configuration (Required for loading cards and images)
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
